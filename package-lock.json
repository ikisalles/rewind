{
  "name": "rewind",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rewind",
      "version": "0.2.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "modules/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@rewind/api",
      "version": "0.2.0",
      "license": "MIT",
      "dependencies": {
        "@rewind/core": "*",
        "@rewind/retro": "*"
      }
    },
    "apps/web": {
      "name": "@rewind/web",
      "version": "0.2.0",
      "license": "MIT",
      "dependencies": {
        "@rewind/retro": "*"
      }
    },
    "modules/retro": {
      "name": "@rewind/retro",
      "version": "0.2.0",
      "license": "MIT",
      "peerDependencies": {
        "@rewind/core": "*"
      }
    },
    "node_modules/@rewind/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@rewind/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@rewind/retro": {
      "resolved": "modules/retro",
      "link": true
    },
    "node_modules/@rewind/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/core": {
      "name": "@rewind/core",
      "version": "0.2.0",
      "license": "MIT"
    }
  }
}
